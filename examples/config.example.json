{
  "schemaVersion": 1,
  "ssh": {
    "connectTimeoutSeconds": 5,
    "hostTimeoutSeconds": 30,
    "concurrency": 8
  },
  "train": {
    "minimum": { "agent-bot": "0.10.62", "geniusbar": "0.1.71" },
    "profileRequired": true,
    "personaRequired": false,
    "servicesRequired": true
  },
  "providers": {
    "ssh-mac": {
      "launchdLabels": ["com.example.agent-bot.daemon", "com.example.agent-comms.broker"]
    },
    "ssh-linux": {
      "systemdUnits": ["agent-bot-daemon", "agent-comms-broker"]
    },
    "github-copilot": {
      "repos": []
    }
  },
  "hosts": [
    { "name": "mac-1", "provider": "ssh-mac", "target": "admin@mac-1.example" },
    { "name": "vm-1", "provider": "ssh-linux", "target": "ubuntu@vm-1.example", "port": 22 },
    { "name": "copilot", "provider": "github-copilot" }
  ]
}
